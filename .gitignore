# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and editors
.vscode/
.idea/
*.swp
*.swo

# Large data files (Strict requirement: Large files are not committed to Git)
data/*.csv
data/*.parquet
data/*.json
data/raw/*.csv
data/raw/*.parquet
data/raw/*.json
data/processed/*.csv
data/processed/*.parquet
data/processed/*.json

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# Operating System files
.DS_Store
Thumbs.db

